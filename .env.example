# API LLM Trader configuration
#
# Copy to `.env` and set AFTERMATH_WALLET_ADDRESS. That is the only required value —
# everything else has a working default. Then run:
#
#     python3 scripts/doctor.py
#
# Loaded via the credentials file or the environment.
# NEVER commit a real .env. NEVER put a private key in this file (see bottom).

# ── Required ──────────────────────────────────────────────────────

# Your Sui wallet address. The only setting you must provide.
AFTERMATH_WALLET_ADDRESS=0x...

# ── API ───────────────────────────────────────────────────────────

# Base URL for the Aftermath API. Defaults to the value below.
#
# NOTE: `v2-preview.aftermath.finance` IS production mainnet, despite the
# hostname. The legacy `aftermath.finance` API is retired and no longer serves
# these routes — do not point this at it, even though the vendored skills and
# the OpenAPI spec's own `servers` block still mention it.
# See AFTERMATH_SKILLS_REF/README-DELTA.md.
#AFTERMATH_HOST=https://v2-preview.aftermath.finance

# ── Gas: you choose how it gets paid ─────────────────────────────
#
#   sponsored  a gas pool pays        — you never need to hold SUI   (default)
#   self       you pay from your SUI  — ordinary Sui gas coin
#   dynamic    another coin pays      — e.g. pay gas in USDC
#
# `sponsored` is the default only because it is the one mode that works for a
# brand-new wallet holding nothing. Change it freely:
#
#     python3 scripts/trade.py gas-set self
#     python3 scripts/trade.py gas-set dynamic --coin <coinType>
#
#AFTERMATH_GAS_MODE=sponsored

# Which coin pays gas in `dynamic` mode. Ignored by the other two modes.
#AFTERMATH_GAS_COIN_TYPE=0xdba34672e30cb065b1f93e3ab55318768fd6fef66c15942c9f7cb846e2f900e7::usdc::USDC

# Gas budget in MIST (1 SUI = 1_000_000_000 MIST). Always set explicitly —
# auto-estimation under-counts the storage cost of newly created objects and
# surfaces later as InsufficientGas on a transaction that simulated fine.
#AFTERMATH_GAS_BUDGET_MIST=50000000

# ── Optional ──────────────────────────────────────────────────────

# Collateral coin type. Defaults to USDC.
#AFTERMATH_COLLATERAL_COIN_TYPE=0xdba34672e30cb065b1f93e3ab55318768fd6fef66c15942c9f7cb846e2f900e7::usdc::USDC

# Pin a specific perps account. Left unset, the CLI discovers accounts you own.
#AFTERMATH_ACCOUNT_NUMBER=0
#AFTERMATH_ACCOUNT_CAP_ID=0x...

# ── Signing ───────────────────────────────────────────────────────
#
# This CLI ships in DRY-RUN: no signer is wired up, so nothing can be signed,
# submitted, or broadcast. Reads and transaction *building* work without any
# key at all — which is everything `doctor` and the market commands need.
#
# Do NOT paste a private key here. When signing is enabled, it will read from a
# dedicated keystore or an external signer, not from this file.

# Live trading is OFF by default. Arming is one explicit flag.
#AFTERMATH_ARMED=false
